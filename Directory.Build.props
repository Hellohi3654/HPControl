<Project>
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!-- Linux builds use Mono's reference assemblies; on Windows the installed .NET Framework 4.8 targeting pack is used -->
    <FrameworkPathOverride Condition="Exists('/usr/lib/mono/4.8-api')">/usr/lib/mono/4.8-api</FrameworkPathOverride>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>CS0649;CS1998</NoWarn>
  </PropertyGroup>
</Project>
